+/**
+ * 抓图片，但**容忍头部封装**（2026-11-04）。
+ *
+ * 为什么需要这个而不是 safeFetchBuffer：QQ 表情 CDN 对部分表情会回
+ * "15 字节私有头 + 真 PNG"，严格魔数校验会在**抓取层就抛错**，
+ * 调用方根本没机会做归一化（上一版补丁就踩了这个坑）。
+ * 这里用 normalizeImageBuffer 替代严格校验：找得到图片起点就切片返回。
+ */
+export async function safeFetchImageBuffer(urlString, maxBytes = 8 * 1024 * 1024) {
+  const r = await safeFetchRaw(urlString, maxBytes);
+  const normalized = normalizeImageBuffer(r.buffer);
+  if (!normalized) {
+    throw new Error(`抓取内容不是有效图片（PNG/JPEG/GIF/WebP）`);
+  }
+  return { ...r, buffer: normalized };
+}
