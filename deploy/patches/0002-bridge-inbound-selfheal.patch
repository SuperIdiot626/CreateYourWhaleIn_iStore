+/** 纯 /proc/net/tcp{,6} 探测某端口是否在本机 LISTEN（不依赖 ss/netstat）。 */
+function portListeningInProc(port) {
+  const hexPort = port.toString(16).toUpperCase().padStart(4, '0');
+  for (const file of ['/proc/net/tcp', '/proc/net/tcp6']) {
+    try {
+      const lines = fs.readFileSync(file, 'utf8').split('\n').slice(1);
+      for (const line of lines) {
+        const parts = line.trim().split(/\s+/);
+        // 状态 0A = LISTEN；parts[1] 是 "本地地址:端口"
+        if (parts.length > 3 && parts[3] === '0A' && String(parts[1]).endsWith(`:${hexPort}`)) return true;
+      }
+    } catch {}
+  }
+  return false;
+}
