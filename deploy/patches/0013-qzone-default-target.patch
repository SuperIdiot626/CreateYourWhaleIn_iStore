+def default_target(self_uin):
+    """不传 uin 时该查谁。
+
+    2026-11-04 修：以前默认查**登录号自己**（机器人账号 3754123574），
+    那个号下一个相册都没有 —— 于是 qzone_albums 永远返回空列表，
+    看起来像"接口挂了"，其实是查错了对象。
+    现在默认查**主人**（config.json 的 ownerQQ / admin.qq），查不到才退回自己。
+    """
+    try:
+        cfg = json.load(open(CFG))
+        for key_path in (("ownerQQ",), ("admin", "qq"), ("owner", "qq")):
+            node = cfg
+            for k in key_path:
+                node = node.get(k) if isinstance(node, dict) else None
+            if node and str(node).strip():
+                return str(node).strip()
+    except Exception:
+        pass
+    return str(self_uin)
+
